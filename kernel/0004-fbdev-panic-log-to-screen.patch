+
+static char plf_lines[PLF_MAX_LINES][PLF_LINE_LEN];
+static struct kmsg_dumper plf_dumper;
+
+static void plf_put(struct fb_info *info, int x, int y, u32 color)
+{
+	unsigned int bytes = info->var.bits_per_pixel / 8;
+	u8 *p = info->screen_base + y * info->fix.line_length + x * bytes;
+
+	switch (bytes) {
+	case 4:
+		__raw_writel(color, p);
+		break;
+	case 2:
+		__raw_writew(color & 0xffff, p);
+		break;
+	default:
+		__raw_writeb(color & 0xff, p);
+		break;
+	}
+}
+
+static void plf_char(struct fb_info *info, int x, int y, unsigned char c)
+{
+	const unsigned char *glyph;
+	int row, col;
+
+	if (c < 32 || c > 126)
+		c = ' ';
+	glyph = plf_font[c - 32];
+
+	for (row = 0; row < PLF_FONT_H; row++) {
+		unsigned char bits = glyph[row];
+
+		for (col = 0; col < PLF_FONT_W; col++) {
+			u32 color = (bits & (0x80 >> col)) ?
+				0xffffffff : 0xff000000;
+
+			plf_put(info, x + col, y + row, color);
+		}
+	}
+}
+
+static void plf_dump(struct kmsg_dumper *dumper,
+		     enum kmsg_dump_reason reason)
+{
+	struct fb_info *info = registered_fb[0];
+	char line[PLF_LINE_LEN];
+	size_t len;
+	int i, first, total = 0;
+
+	if (reason != KMSG_DUMP_PANIC)
+		return;
+	if (!info || !info->screen_base)
+		return;
+
+	while (kmsg_dump_get_line(dumper, false, line, sizeof(line), &len)) {
+		int idx = total % PLF_MAX_LINES;
+		size_t n = len;
+
+		if (n >= PLF_LINE_LEN)
+			n = PLF_LINE_LEN - 1;
+		memcpy(plf_lines[idx], line, n);
+		plf_lines[idx][n] = 0;
+		total++;
+	}
+	if (!total)
+		return;
+
+	first = total > PLF_MAX_LINES ? total - PLF_MAX_LINES : 0;
+
+	for (i = 0; i < PLF_MAX_LINES && first + i < total; i++) {
+		const char *s = plf_lines[(first + i) % PLF_MAX_LINES];
+		int x = 0;
+
+		if (i * PLF_FONT_H + PLF_FONT_H > info->var.yres)
+			break;
+		while (*s && x + PLF_FONT_W <= info->var.xres) {
+			plf_char(info, x, i * PLF_FONT_H, (unsigned char)*s);
+			s++;
+			x += PLF_FONT_W;
+		}
+	}
+}
+
+static int __init plf_init(void)
+{
+	plf_dumper.dump = plf_dump;
+	plf_dumper.max_reason = KMSG_DUMP_PANIC;
+	return kmsg_dump_register(&plf_dumper);
+}
+late_initcall(plf_init);

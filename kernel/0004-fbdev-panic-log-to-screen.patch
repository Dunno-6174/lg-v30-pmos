+#include <linux/init.h>
+#include <linux/kmsg_dump.h>
+#include <linux/fb.h>
+#include <linux/string.h>
+#include <linux/io.h>
+
+#define PLF_MAX_LINES 140
+#define PLF_LINE_LEN  200
+#define PLF_FONT_W    8
+#define PLF_FONT_H    8

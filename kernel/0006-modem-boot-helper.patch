diff -Nur a/drivers/misc/Makefile b/drivers/misc/Makefile
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -66,3 +66,5 @@
 obj-y				+= qcom/
 obj-$(CONFIG_QPNP_MISC) 	+= qpnp-misc.o
 obj-$(CONFIG_MEMORY_STATE_TIME) += memory_state_time.o
+
+obj-m += modem_boot.o
diff -Nur a/drivers/misc/modem_boot.c b/drivers/misc/modem_boot.c
--- a/drivers/misc/modem_boot.c
+++ b/drivers/misc/modem_boot.c
@@ -0,0 +1,31 @@
+/*
+ * modem_boot.c - tiny helper to boot the msm modem subsystem from userspace.
+ *
+ * insmod modem_boot.ko  -> subsystem_get("modem")
+ * rmmod modem_boot      -> subsystem_put("modem")
+ */
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+extern int subsystem_get(const char *name);
+extern void subsystem_put(const char *name);
+
+static int __init modem_boot_init(void)
+{
+	int ret = subsystem_get("modem");
+
+	pr_info("modem_boot: subsystem_get(modem) = %d\n", ret);
+	return 0;
+}
+
+static void __exit modem_boot_exit(void)
+{
+	subsystem_put("modem");
+	pr_info("modem_boot: subsystem_put(modem)\n");
+}
+
+module_init(modem_boot_init);
+module_exit(modem_boot_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Boot the msm modem subsystem");

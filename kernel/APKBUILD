# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/lineageos_joan_defconfig

maintainer="rock <rock@localhost.localdomain>"
pkgname=linux-lg-joan
pkgver=4.4.302
pkgrel=28
pkgdesc="LG V30 (joan) kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="lg-joan"
_config="config-lg-joan.aarch64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	devicepkg-dev
	elfutils-dev
	flex
	gcc6
	gmp-dev
	installkernel
	kmod
	linux-headers
	openssl-dev
	perl
	sed
"

# Compiler: GCC 6. The LG msm8998 4.4 kernel is known to build and boot with
# GCC 6; newer GCC versions tend to break the Android kernel fork.
if [ "${CC:0:5}" != "gcc6-" ]; then
	CC="gcc6-$CC"
	HOSTCC="gcc6-gcc"
	CROSS_COMPILE="gcc6-$CROSS_COMPILE"
fi

# Source
_repository="android_kernel_lge_msm8998"
_commit="88b7c55fc5ffb3b2afec02bf21f3c9c6082b1236"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	0001-dummycon-fix-build-with-CONFIG_VT.patch
	0002-bluetooth-add-rx_lock-to-hci_uart.patch
	0003-configfs-build-without-uevent.patch
	0004-fbdev-panic-log-to-screen.patch
	0005-cfg80211-add-ieee80211-band-aliases.patch
	0006-modem-boot-helper.patch
	0007-wifi-module-build-fixes.patch
	0008-icnss-wlfw-probe-retry.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	. downstreamkernel_prepare

	# Lay the config out like the LG/LineageOS build does. Running the
	# config through "make <name>_defconfig" instead of only "oldconfig"
	# is important: Kconfig's tristate choice for the USB gadget driver
	# otherwise resolves to CONFIG_USB_CONFIGFS=m, which breaks the
	# vmlinux link because LG's built-in f_laf driver needs libcomposite.
	cp "$srcdir/$_config" \
		"$builddir/arch/$_carch/configs/pmos_lg_joan_defconfig"
	make -C "$builddir" O="$_outdir" ARCH="$_carch" \
		pmos_lg_joan_defconfig
}

build() {
	unset LDFLAGS
	# The LG kernel appends its DTB to the kernel image, so build Image.gz-dtb
	# explicitly (a plain "make" would only build the DTB-less Image.gz).
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" Image.gz-dtb modules \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}

package() {
	KERNEL_IMAGE_NAME="Image.gz-dtb" \
		downstreamkernel_package "$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
	local _rel
	_rel="$(cat "$builddir/$_outdir/include/config/kernel.release")"
	depmod -b "$pkgdir/usr" "$_rel" 2>/dev/null || true

}


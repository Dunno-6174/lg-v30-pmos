#!/bin/sh
# Enable WCN3990 Bluetooth: H4 over ttyHS0 bridged to /dev/vhci.
rfkill unblock bluetooth 2>/dev/null
modprobe hci_vhci 2>/dev/null
# wait for the controller to answer HCI (it powers up slowly after boot)
python3 /usr/local/bin/btwait.py >/dev/null 2>&1
# fresh vhci device -> hci0
pkill -f '/usr/local/bin/bth4vhci.py' 2>/dev/null
rmmod hci_vhci 2>/dev/null
modprobe hci_vhci 2>/dev/null
sleep 1
setsid python3 -u /usr/local/bin/bth4vhci.py >/var/log/btbridge.log 2>&1 </dev/null &
sleep 2
rc-service bluetooth start 2>/dev/null
sleep 2
bluetoothctl power on >/dev/null 2>&1
exit 0
